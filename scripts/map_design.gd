static func cell_count() -> int:
	return W * H


static func code_at(x: int, y: int) -> int:
	if x < 0 or y < 0 or x >= W or y >= H:
		return -1
	return GROUND.unicode_at(y * W + x) - 48


static func bytes() -> PackedByteArray:
	var out := PackedByteArray()
	out.resize(W * H)
	for i in W * H:
		out[i] = GROUND.unicode_at(i) - 48
	return out


static func objects() -> Array:
	return _OBJECTS.duplicate(true)


static func count_kind(kind: String) -> int:
	var n := 0
	for item in _OBJECTS:
		var row: Dictionary = item
		if str(row.get("kind", "")) == kind:
			n += 1
	return n


static func rects(code: int) -> Array:
	var used := PackedByteArray()
	used.resize(W * H)
	var out: Array = []
	for y in H:
		for x in W:
			var start := y * W + x
			if int(used[start]) != 0 or code_at(x, y) != code:
				continue
			var w := 1
			while x + w < W and int(used[start + w]) == 0 and code_at(x + w, y) == code:
				w += 1
			var h := 1
			while y + h < H:
				var row_fits := true
				for i in w:
					var at := (y + h) * W + x + i
					if int(used[at]) != 0 or code_at(x + i, y + h) != code:
						row_fits = false
						break
				if not row_fits:
					break
				h += 1
			for yy in h:
				for xx in w:
					used[(y + yy) * W + x + xx] = 1
			out.append(Rect2(float(x), float(y), float(w), float(h)))
	return out


static func component_rects(code: int) -> Array:
	var seen := PackedByteArray()
	seen.resize(W * H)
	var out: Array = []
	for y in H:
		for x in W:
			var start := y * W + x
			if int(seen[start]) != 0 or code_at(x, y) != code:
				continue
			var min_x := x
			var max_x := x
			var min_y := y
			var max_y := y
			var stack: Array = [Vector2i(x, y)]
			seen[start] = 1
			while stack.size() > 0:
				var cur: Vector2i = stack.pop_back()
				min_x = mini(min_x, cur.x)
				max_x = maxi(max_x, cur.x)
				min_y = mini(min_y, cur.y)
				max_y = maxi(max_y, cur.y)
				for step in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
					var nxt: Vector2i = step
					var nx := cur.x + nxt.x
					var ny := cur.y + nxt.y
					if nx < 0 or ny < 0 or nx >= W or ny >= H:
						continue
					var ni := ny * W + nx
					if int(seen[ni]) != 0 or code_at(nx, ny) != code:
						continue
					seen[ni] = 1
					stack.append(Vector2i(nx, ny))
			out.append(Rect2(float(min_x), float(min_y), float(max_x - min_x + 1), float(max_y - min_y + 1)))
	return out
